# Database (host-run backend). Docker Compose Postgres is mapped to localhost:5432.
DATABASE_URL=postgresql://messwise:messwise_dev@localhost:5432/messwise

# Server
PORT=3000
NODE_ENV=development

# Comma-separated browser origins
FRONTEND_URL=http://localhost:5173

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
