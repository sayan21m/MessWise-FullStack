{
  "name": "messwise",
  "version": "1.0.0",
  "description": "MessWise is a full-stack mess management platform with a Node.js/Express API, React frontend, and PostgreSQL via Prisma.",
  "keywords": [
    "mess-management"
  ],
  "license": "ISC",
  "author": "sayan21m",
  "type": "module",
  "main": "apps/backend/src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node apps/backend/src/index.js",
    "dev": "nodemon apps/backend/src/index.js",
    "dev:frontend": "npm run dev --prefix apps/frontend",
    "build": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "postinstall": "prisma generate || exit 0",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "supertest": "^7.3.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "resend": "^6.39.0",
    "zod": "^4.6.5"
  }
}
